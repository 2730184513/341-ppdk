# Set your real HTTPS origin. Use a dedicated hostname and no trailing slash.
PPDK_SITE=https://learning.example.edu

# Fill all three values before startup. Keep the resulting .env on the server.
# Use different strong, randomly generated values. Hex strings avoid env-file interpolation.
DB_PASSWORD=
PPDK_DEMO_PASSWORD_A=
PPDK_DEMO_PASSWORD_B=
