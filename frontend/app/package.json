{
  "name": "ppdk-frontend-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "generate:types": "openapi-typescript ../contracts/http/openapi.json -o src/api/schema.d.ts && node scripts/generate-validators.mjs && node scripts/generate-worker.mjs && node scripts/generate-runtime-mocks.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "build:live": "node scripts/runtime/build-live.mjs"
  },
  "dependencies": {
    "msw": "2.12.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
